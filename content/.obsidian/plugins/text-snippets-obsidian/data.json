{
  "snippets_file": "warn : > [!warning]\n\ninfo : > [!info]\n\ntip : > [!tip]\n\ndanger : > [!danger]",
  "snippets": [
    "warn : > [!warning]",
    "info : > [!info]",
    "tip : > [!tip]",
    "danger : > [!danger]"
  ],
  "endSymbol": "$end$",
  "newlineSymbol": "$nl$",
  "stopSymbol": "$tb$",
  "pasteSymbol": "$pst$",
  "useTab": true,
  "useSpace": false,
  "wordDelimiters": "$()[]{}<>,.!?;:'\"\\/",
  "isWYSIWYG": true
}